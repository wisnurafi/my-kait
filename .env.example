# ============================================
# My Kait — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================

# --- Discord OAuth ---
# 1. Go to https://discord.com/developers/applications
# 2. Create a new application
# 3. Go to OAuth2 tab → copy Client ID and Client Secret
# 4. Add redirect URI: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Auth.js Secret ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- App URL ---
# Use http://localhost:3000 for dev
AUTH_URL=http://localhost:3000

# --- Neon Postgres ---
# 1. Go to https://neon.tech and create a project
# 2. Copy the POOLED connection string (has -pooler in hostname)
DATABASE_URL=

# --- Upstash Redis (Rate Limiting) ---
# 1. Go to https://upstash.com and create a Redis DB
# 2. Copy REST URL and REST Token (under REST API section)
# Note: If not set, rate limiting is disabled (dev mode only).
# REQUIRED in production — the app refuses to boot without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Webhook URL Encryption Key ---
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY_VERSION=1

# --- Vercel Cron Secret ---
# Generate with: openssl rand -hex 16
# REQUIRED in production — the app refuses to boot if unset or left as the dev default.
CRON_SECRET=

# --- Admin Dashboard (single account, no sign-up) ---
# Login page is NOT linked anywhere in the UI — open /<locale>/admin/login directly.
# Generate the hash with: node scripts/hash-admin-password.mjs
# NEVER commit real values. When unset, admin login is disabled.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Admin Notifications (optional) ---
# Discord webhook URL for ops pings (e.g. new template reports).
# Create in a private channel: Server Settings → Integrations → Webhooks.
# When unset, no notifications are sent.
ADMIN_NOTIFY_WEBHOOK_URL=
